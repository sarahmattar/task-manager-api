{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names mongo,mail,api --prefix-colors green,magenta,cyan \"npm:dev:mongo\" \"npm:dev:mail\" \"npm:dev:api\"",
    "dev:api": "env-cmd -f ./config/dev.env nodemon src/index.js",
    "dev:mongo": "nc -z 127.0.0.1 27017 2>/dev/null && echo 'MongoDB already running on 27017, skipping' || $HOME/mongodb/bin/mongod --dbpath=$HOME/mongodb-data --quiet",
    "dev:mail": "nc -z 127.0.0.1 1025 2>/dev/null && echo 'Mailpit already running on 1025, skipping' || mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025",
    "start": "node src/index.js",
    "test": "env-cmd -f ./config/test.env jest --watch --runInBand --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^4.3.1",
    "mongoose": "^8.9.5",
    "multer": "^2.0.1",
    "nodemailer": "^10.6.0",
    "sharp": "^0.35.0",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "env-cmd": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.4",
    "supertest": "^4.0.2"
  }
}
